# Скопируй в .env и поправь под себя: cp .env.example .env
# Сервер не стартует, если что-то из обязательного не задано или задано неверно.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Строка подключения к Postgres. Значения совпадают с docker-compose.yml.
DATABASE_URL=postgres://gavan:gavan@localhost:5432/gavan

# Origin клиента — нужен для CORS и для cookie с сессией.
WEB_ORIGIN=http://localhost:5173

# Адрес сервера для клиента. Переменные с префиксом VITE_ попадают в бандл,
# секретов здесь быть не может.
VITE_SERVER_URL=http://localhost:3000
